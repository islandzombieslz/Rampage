{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rampage-history",
  "main": "src/index.js",
  "compatibility_date": "2026-10-02",
  "durable_objects": {
    "bindings": [
      {
        "name": "HISTORY_ROOMS",
        "class_name": "HistoryRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["HistoryRoom"]
    }
  ]
}
